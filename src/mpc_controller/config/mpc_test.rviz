Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    # ── Grid ──────────────────────────────────────────────────────────────
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 5
      Line Style:
        Line Width: 0.03
        Value: Lines
      Normal Cell Count: 0
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: map
      Color: 100; 100; 100

    # ── TF Frames ─────────────────────────────────────────────────────────
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 1.5
      Show Arrows: true
      Show Axes: true
      Show Names: true

    # ── Track Centerline + Boundaries ─────────────────────────────────────
    - Class: rviz_default_plugins/MarkerArray
      Name: Track
      Enabled: true
      Topic:
        Value: /mpc/track_markers
        Depth: 5

        Reliability Policy: Reliable

    # ── Heading Arrow ─────────────────────────────────────────────────────
    - Class: rviz_default_plugins/Marker
      Name: Heading
      Enabled: true
      Topic:
        Value: /mpc/heading_arrow
        Depth: 5
        Reliability Policy: Reliable

    # ── Vehicle Footprint ─────────────────────────────────────────────────
    - Class: rviz_default_plugins/Marker
      Name: Vehicle
      Enabled: true
      Topic:
        Value: /mpc/vehicle_footprint
        Depth: 5
        Reliability Policy: Reliable

    # ── Track Constraint Normals ──────────────────────────────────────────
    - Class: rviz_default_plugins/MarkerArray
      Name: Constraints
      Enabled: true
      Topic:
        Value: /mpc/constraint_markers
        Depth: 5
        Reliability Policy: Reliable

    # ── MPC Predicted Path (nav_msgs/Path) ────────────────────────────────
    - Class: rviz_default_plugins/Path
      Name: MPC Predicted Path
      Enabled: true
      Topic:
        Value: /mpc/predicted_path
        Depth: 5
        Reliability Policy: Reliable
      Color: 255; 0; 255
      Line Style: Lines
      Line Width: 0.08
      Pose Style: None

    # ── MPC Predicted Path Viz (line + step spheres) ──────────────────────
    - Class: rviz_default_plugins/MarkerArray
      Name: MPC Predicted Viz
      Enabled: true
      Topic:
        Value: /mpc/predicted_path_viz
        Depth: 5
        Reliability Policy: Reliable

    # ── Reference Path (nav_msgs/Path) ────────────────────────────────────
    - Class: rviz_default_plugins/Path
      Name: Reference Path
      Enabled: true
      Topic:
        Value: /reference_path
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color: 0; 200; 0
      Line Style: Lines
      Line Width: 0.05
      Pose Style: None

  Global Options:
    Background Color: 30; 30; 30
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/ThirdPersonFollower
      Name: ThirdPersonFollower
      Distance: 120
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Pitch: 0.8
      Target Frame: base_link
      Yaw: 3.14
